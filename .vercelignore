# Build inputs only. Everything below is either regenerated by the build,
# irrelevant to it, or must never leave the machine.
#
# Without this file the CLI walks the entire tree, including .next from a local
# build, and saturates the connection uploading files the build does not read.

.git
.github
node_modules
.next
out
.vercel

# documentation and operational tooling: not build inputs
docs
scripts
*.md

# local environment, never uploaded
.env
.env.*
!.env.example

# editor and OS noise
.vscode
.idea
.DS_Store
*.log
*.tsbuildinfo
