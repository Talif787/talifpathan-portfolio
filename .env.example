# Absolute origin of the deployed site. Used for canonical URLs, Open Graph
# metadata, robots.txt and sitemap.xml. Without it those fall back to
# http://localhost:3000, which is fine locally and wrong in production.
#
# NEXT_PUBLIC_* variables are inlined at BUILD time, not read at runtime:
# set this before `npm run build`, not after.
NEXT_PUBLIC_SITE_URL=https://talifpathan.vercel.app
